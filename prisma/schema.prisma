generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// USERS & AUTHENTICATION
// ===========================================

enum Role {
  ADMIN
  COACH
  CLIENT
  SUPPORT
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  passwordHash      String?
  firstName         String
  lastName          String
  avatarUrl         String?
  bio               String?   @db.Text  // korte beschrijving, niet verplicht
  role              Role      @default(CLIENT)
  phone             String?
  shopifyCustomerId String?   @unique
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  lastLoginAt       DateTime?
  deletedAt         DateTime?

  // Relations
  sessions          AuthSession[]
  enrollments       Enrollment[]
  progress          Progress[]
  spaceMemberships  SpaceMember[]
  posts             Post[]
  comments          Comment[]
  conversationParticipants ConversationParticipant[]
  messages          Message[]
  sessionsAsClient  CoachingSession[] @relation("ClientSessions")
  sessionsAsCoach   CoachingSession[] @relation("CoachSessions")
  checkIns          CheckIn[]
  nutritionLogs     NutritionLog[]
  habitLogs         HabitLog[]
  cycleLogs         CycleLog[]
  symptomLogs       SymptomLog[]
  groceryLists      GroceryList[]
  mealPlans         MealPlan[]
  aiConversations   AiConversation[]
  whatsappMessages  WhatsappMessage[]
  notifications     Notification[]
  progressPhotos    ProgressPhoto[]
  fitnessConnections FitnessConnection[]
  workouts          Workout[]
  weeklySummaries   WeeklySummary[]

  @@index([email])
  @@index([shopifyCustomerId])
}

model VerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  type      String    // "magic_link" | "registration" | "password_reset"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

// ===========================================
// COURSES & LEARNING
// ===========================================

model Course {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  description     String?   @db.Text
  thumbnailUrl    String?
  isPublished     Boolean   @default(false)
  isPrivate       Boolean   @default(false)
  
  // Minicursus zonder community: false; traject met groep: true
  hasCommunity    Boolean   @default(true)
  
  drippingEnabled Boolean   @default(false)
  drippingUnit    String?   // "days" | "weeks"
  
  // Progressiefoto's: aantal momenten en interval (weken vanaf start inschrijving)
  photoMomentsCount         Int       @default(0)
  photoMomentsIntervalWeeks Int?      // bijv. 4 = week 0, 4, 8, ...
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  modules             Module[]
  enrollments         Enrollment[]
  progressPhotos     ProgressPhoto[]
  coachingRecordings  CoachingRecording[]
  shopifyMappings    ShopifyProductMapping[]

  @@index([slug])
}

model CoachingRecording {
  id                      String    @id @default(cuid())
  courseId                String
  course                  Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  recurrenceOccurrenceKey String?   // groepssessie: recur-{courseId}-{iso}
  dailyRecordingId       String    @unique // Daily.co recording ID
  title                   String?
  scheduledAt             DateTime?
  durationSecs            Int?
  createdAt               DateTime  @default(now())

  @@index([courseId])
  @@index([dailyRecordingId])
}

model Module {
  id              String   @id @default(cuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String?  @db.Text
  position        Int
  unlockAfterDays Int?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lessons         Lesson[]

  @@index([courseId])
}

model Lesson {
  id              String   @id @default(cuid())
  moduleId        String
  module          Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title           String
  content         String?  @db.Text
  position        Int
  
  videoUrl        String?
  videoProvider   String?  // "loom" | "mux" | "upload"
  videoDuration   Int?
  unlockAfterDays Int?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  progress        Progress[]
  attachments     LessonAttachment[]

  @@index([moduleId])
}

model LessonAttachment {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      String   // "pdf" | "image" | "file"
  size      Int?
  createdAt DateTime @default(now())

  @@index([lessonId])
}

model Enrollment {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  startDate        DateTime  @default(now())
  endDate          DateTime?
  
  shopifyOrderId   String?
  shopifyProductId String?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model ProgressPhoto {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  periodIndex     Int       // 0-based moment (week 0, 4, 8, ...)
  beforePhotoUrl  String?
  afterPhotoUrl   String?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, courseId, periodIndex])
  @@index([userId])
  @@index([courseId])
}

model Progress {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId      String
  lesson        Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  completedAt   DateTime?
  videoProgress Int?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// ===========================================
// COMMUNITY
// ===========================================

model Space {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  iconEmoji   String?
  
  isPublic    Boolean  @default(false)
  isHostOnly  Boolean  @default(false)
  position    Int      @default(0)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     SpaceMember[]
  posts       Post[]

  @@index([slug])
}

model SpaceMember {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())

  @@unique([userId, spaceId])
  @@index([userId])
  @@index([spaceId])
}

model Post {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  workoutId String?  @unique
  workout   Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments    Comment[]
  attachments PostAttachment[]
  likes       PostLike[]

  @@index([spaceId])
  @@index([authorId])
}

model PostAttachment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  type      String   // "image" | "voice_memo" | "file"
  duration  Int?
  createdAt DateTime @default(now())

  @@index([postId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  
  content   String    @db.Text
  
  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([postId])
  @@index([authorId])
}

// ===========================================
// FITNESS / SPORTHORLOGES
// ===========================================

model FitnessConnection {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String    // "strava" | "fitbit" | "garmin" | "polar" | "apple"
  providerUserId String?
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model Workout {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String    // "strava" | "fitbit" | ...
  providerWorkoutId  String
  type               String?   // "Run" | "Ride" | "Walk" | ...
  name               String?
  distance           Float?   // meter
  durationSeconds    Int?
  elevationGain      Float?
  calories           Float?
  heartRateAvg       Int?
  heartRateMax       Int?
  startTime          DateTime
  endTime            DateTime?
  isPublic           Boolean   @default(false)
  syncedAt           DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  post               Post?

  @@unique([userId, provider, providerWorkoutId])
  @@index([userId])
  @@index([provider])
  @@index([startTime])
  @@index([isPublic])
}

// ===========================================
// MESSAGING
// ===========================================

model Conversation {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime?

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  content        String       @db.Text
  voiceUrl       String?
  voiceDuration  Int?
  
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

// ===========================================
// COACHING SESSIONS
// ===========================================

model CoachingSession {
  id          String    @id @default(cuid())
  clientId    String
  client      User      @relation("ClientSessions", fields: [clientId], references: [id], onDelete: Cascade)
  coachId     String
  coach       User      @relation("CoachSessions", fields: [coachId], references: [id], onDelete: Cascade)
  
  title       String?
  scheduledAt DateTime
  duration    Int       @default(45)
  
  roomId      String?
  roomUrl     String?
  
  // Groepssessie: meerdere sessies delen dezelfde room via deze key (bijv. recur-{courseId}-{isoDateTime})
  recurrenceOccurrenceKey String?
  
  status      String    @default("scheduled") // "scheduled" | "completed" | "cancelled"
  completedAt DateTime?
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  notes       SessionNote[]

  @@index([clientId])
  @@index([coachId])
  @@index([scheduledAt])
  @@index([recurrenceOccurrenceKey])
}

model SessionNote {
  id                 String          @id @default(cuid())
  sessionId          String
  session            CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  content            String          @db.Text
  isSharedWithClient Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([sessionId])
}

// ===========================================
// TRACKERS
// ===========================================

model CheckIn {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  weekNumber Int
  year       Int
  date       DateTime
  
  weight     Float?
  waist      Float?
  hip        Float?
  arm        Float?
  
  photoFront String?
  photoSide  String?
  photoBack  String?
  
  notes      String?  @db.Text
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, weekNumber, year])
  @@index([userId])
}

model NutritionLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date      DateTime @db.Date
  
  calories  Int?
  protein   Int?
  carbs     Int?
  fat       Int?
  
  entries   Json?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model HabitLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date         DateTime @db.Date
  
  waterGlasses Int?
  steps        Int?
  supplements  Boolean?
  
  customHabits Json?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model CycleLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date      DateTime @db.Date
  
  phase     String?
  flowLevel Int?
  
  notes     String?  @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model SymptomLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  date      DateTime @db.Date
  
  energy    Int?
  cravings  Int?
  digestion Int?
  sleep     Int?
  mood      Int?
  
  notes     String?  @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// ===========================================
// RECIPES & MEAL PLANNING
// ===========================================

model Recipe {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String?  @db.Text
  imageUrl     String?
  
  calories     Int?
  protein      Int?
  carbs        Int?
  fat          Int?
  
  servings     Int      @default(2)
  prepTime     Int?
  cookTime     Int?
  
  ingredients  Json
  instructions Json
  
  category     String?
  tags         String[]
  
  isPublished  Boolean  @default(false)
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groceryItems  GroceryItem[]
  mealPlanItems MealPlanItem[]

  @@index([slug])
  @@index([category])
}

model GroceryList {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name      String        @default("Boodschappenlijst")
  
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  items     GroceryItem[]

  @@index([userId])
}

model GroceryItem {
  id            String      @id @default(cuid())
  groceryListId String
  groceryList   GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  recipeId      String?
  recipe        Recipe?     @relation(fields: [recipeId], references: [id])
  
  ingredient    String
  amount        String?
  unit          String?
  isChecked     Boolean     @default(false)
  
  createdAt     DateTime    @default(now())

  @@index([groceryListId])
}

model MealPlan {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  weekStart DateTime       @db.Date
  
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  items     MealPlanItem[]

  @@unique([userId, weekStart])
  @@index([userId])
}

model MealPlanItem {
  id         String   @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipeId   String
  recipe     Recipe   @relation(fields: [recipeId], references: [id])
  
  dayOfWeek  Int
  mealType   String

  @@index([mealPlanId])
}

model NutritionPlan {
  id        String   @id @default(cuid())
  userId    String
  
  title     String
  fileUrl   String
  
  createdAt DateTime @default(now())

  @@index([userId])
}

// ===========================================
// PRODUCTEN / KENNISBANK (voor iedereen, alle cursussen)
// ===========================================

model KnowledgeCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     KnowledgeItem[]

  @@index([slug])
}

model KnowledgeItem {
  id         String   @id @default(cuid())
  categoryId String
  category   KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title      String
  videoUrl   String?  // Loom of andere embed
  videoProvider String?  // "loom" | "mux" | "youtube" | ...
  description String? @db.Text
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
}

model FavoriteProduct {
  id           String   @id @default(cuid())
  brand        String   // bijv. "Pit & Pit"
  name         String
  description  String?  @db.Text  // uitleg, "mijn lijstje", etc.
  discountCode String?
  productUrl   String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([position])
}

// ===========================================
// AI (SIX)
// ===========================================

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages  AiMessage[]

  @@index([userId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  
  role           String         // "user" | "assistant"
  content        String         @db.Text
  
  feedback       String?        // "positive" | "negative"
  feedbackNote   String?
  
  sourceIds      String[]
  
  createdAt      DateTime       @default(now())

  @@index([conversationId])
}

model AiSource {
  id        String   @id @default(cuid())
  
  title     String
  content   String   @db.Text
  type      String   // "course" | "qa" | "guideline" | "recipe" | "custom"
  sourceRef String?
  
  tags      String[]
  isActive  Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model AiDailyTip {
  id            String   @id @default(cuid())
  content       String   @db.Text
  scheduledDate DateTime @db.Date
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([scheduledDate])
}

// ===========================================
// WEEKLY SUMMARY (Strava-achtig weekoverzicht)
// ===========================================

model WeeklySummary {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart   DateTime @db.Date   // maandag van de week
  highlights  Json      // { stepsTotal, stepsDelta, weightDelta, workoutsCount, recipeTitles[], postsCount, commentsCount, likesReceived, ... }
  shareImageUrl String?           // optioneel: gegenereerde share-afbeelding
  createdAt   DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
  @@index([weekStart])
}

// ===========================================
// WHATSAPP & NOTIFICATIONS
// ===========================================

model WhatsappMessage {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  phoneNumber String
  message     String    @db.Text
  templateId  String?
  mediaUrl    String?   // voice of meme (image)
  mediaType   String?   // "image" | "audio"
  
  status      String    // "pending" | "sent" | "delivered" | "failed"
  externalId  String?
  sentAt      DateTime?
  
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type      String    // "reminder" | "session" | "message" | "community" | "session_reminder"
  title     String
  body      String
  link      String?
  sessionId String?   // voor session_reminder: welke sessie, om dubbele te voorkomen
  
  isRead    Boolean   @default(false)
  readAt    DateTime?
  
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([sessionId, type])
}

// ===========================================
// SYSTEM
// ===========================================

model ShopifyProductMapping {
  id               String   @id @default(cuid())
  shopifyProductId String   @unique
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  accessDays       Int?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([courseId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  isEnabled   Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ===========================================
// LANDING PAGES (online editor)
// ===========================================

model LandingPage {
  id        String   @id @default(cuid())
  title     String   // paginatitel / browser tab
  slug      String   @unique
  headline  String?  // hero titel
  subheadline String? @db.Text
  isPublished Boolean @default(false)

  // Shopify (voor product-blokken): optioneel, kan ook per blok
  shopifyStoreDomain       String?
  shopifyStorefrontToken   String?

  // Blokken: tekst, afbeelding, video, product, Calendly, CTA, etc.
  blocks    Json     // [{ type: 'heading'|'text'|'image'|'video'|'product'|'calendly'|'cta', ... }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}
