  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  waterGlasses Int?
  steps        Int?
  supplements  Boolean?

  customHabits Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model CycleLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  phase     String?
  flowLevel Int?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model SymptomLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  date DateTime @db.Date

  energy    Int?
  cravings  Int?
  digestion Int?
  sleep     Int?
  mood      Int?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// ===========================================
// RECIPES & MEAL PLANNING
// ===========================================

model Recipe {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String? @db.Text
  imageUrl    String?

  calories Int?
  protein  Int?
  carbs    Int?
  fat      Int?

  servings Int  @default(2)
  prepTime Int?
  cookTime Int?

  ingredients  Json
  instructions Json

  category String?
  tags     String[]

  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groceryItems  GroceryItem[]
  mealPlanItems MealPlanItem[]
  favoritedBy   UserFavoriteRecipe[]

  @@index([slug])
  @@index([category])
}

model GroceryList {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String @default("Boodschappenlijst")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items GroceryItem[]

  @@index([userId])
}

model GroceryItem {
  id            String      @id @default(cuid())
  groceryListId String
  groceryList   GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  recipeId      String?
  recipe        Recipe?     @relation(fields: [recipeId], references: [id])

  ingredient String
  amount     String?
  unit       String?
  isChecked  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([groceryListId])
}

model MealPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStart                DateTime @db.Date
  calorieCalculatorEnabled Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items MealPlanItem[]

  @@unique([userId, weekStart])
  @@index([userId])
}

model MealPlanItem {
  id         String   @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  recipeId   String?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id])

  dayOfWeek         Int
  mealType          String
  isCustom          Boolean @default(false)
  customTitle       String?
  customDescription String? @db.Text
  customImageUrl    String?
  customCalories    Int?
  customProtein     Int?
  customCarbs       Int?
  customFat         Int?
  customFiber       Int?
  customIngredients Json?

  @@index([mealPlanId])
}

model UserCustomRecipe {
  id          String               @id @default(cuid())
  userId      String
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?              @db.Text
  imageUrl    String?
  calories    Int?
  protein     Int?
  carbs       Int?
  fat         Int?
  fiber       Int?
  ingredients Json?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  favoritedBy UserFavoriteRecipe[]

  @@index([userId])
}

model UserFavoriteRecipe {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipeId       String?
  recipe         Recipe?           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  customRecipeId String?
  customRecipe   UserCustomRecipe? @relation(fields: [customRecipeId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@unique([userId, recipeId])
  @@unique([userId, customRecipeId])
  @@index([userId])
  @@index([recipeId])
  @@index([customRecipeId])
}

model NutritionPlan {
  id         String                 @id @default(cuid())
  userId     String
  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId   String?
  course     Course?                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  templateId String?
  template   NutritionPlanTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  title           String
  fileUrl         String
  displayFileName String?
  availableAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([availableAt])
}

model NutritionPlanTemplate {
  id            String        @id @default(cuid())
  courseId      String
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  biologicalSex BiologicalSex
  title         String
  fileUrl       String
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  plans NutritionPlan[]

  @@unique([courseId, biologicalSex])
  @@index([courseId])
}

// ===========================================
// PRODUCTEN / KENNISBANK (voor iedereen, alle cursussen)
// ===========================================

model KnowledgeCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items KnowledgeItem[]

  @@index([slug])
}

model KnowledgeItem {
  id            String            @id @default(cuid())
  categoryId    String
  category      KnowledgeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title         String
  videoUrl      String? // Loom of andere embed
  videoProvider String? // "loom" | "mux" | "youtube" | ...
  description   String?           @db.Text
  position      Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([categoryId])
}

model FavoriteProduct {
  id           String   @id @default(cuid())
  brand        String // bijv. "Pit & Pit"
  name         String
  description  String?  @db.Text // uitleg, "mijn lijstje", etc.
  discountCode String?
  productUrl   String?
  position     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([position])
}

// ===========================================
// AI (SIX)
// ===========================================

model AiConversation {
  id       String  @id @default(cuid())
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String?
  title    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages    AiMessage[]
  escalations AiEscalation[]

  @@index([userId])
  @@index([tenantId])
}

model AiEscalation {
  id             String          @id @default(cuid())
  tenantId       String?
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String?
  conversation   AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  question       String          @db.Text
  reason         String // "no_source" | "medical" | "personal" | "negative_feedback"
  priority       String          @default("normal") // "normal" | "high" | "urgent"
  status         String          @default("open") // "open" | "resolved" | "dismissed"
  resolution     String?         @db.Text
  resolvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenantId, status])
  @@index([userId])
  @@index([createdAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    String // "user" | "assistant"
  content String @db.Text

  feedback     String? // "positive" | "negative"
  feedbackNote String?

  sourceIds String[]

  createdAt DateTime @default(now())

  @@index([conversationId])
}

model AiSource {
  id       String  @id @default(cuid())
  tenantId String?

  title     String
  content   String  @db.Text
  type      String // "course" | "qa" | "guideline" | "recipe" | "custom"
  sourceRef String?

  tags     String[]
  isActive Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([tenantId])
}

model AiDailyTip {
  id            String   @id @default(cuid())
  content       String   @db.Text
  scheduledDate DateTime @db.Date
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([scheduledDate])
}

// ===========================================
// WEEKLY SUMMARY (Strava-achtig weekoverzicht)
// ===========================================

model WeeklySummary {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart     DateTime @db.Date // maandag van de week
  highlights    Json // { stepsTotal, stepsDelta, weightDelta, workoutsCount, recipeTitles[], postsCount, commentsCount, likesReceived, ... }
  shareImageUrl String? // optioneel: gegenereerde share-afbeelding
  createdAt     DateTime @default(now())

  @@unique([userId, weekStart])
  @@index([userId])
  @@index([weekStart])
}

// ===========================================
// WHATSAPP & NOTIFICATIONS
// ===========================================

model WhatsappMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phoneNumber String
  message     String  @db.Text
  templateId  String?
  mediaUrl    String? // voice of meme (image)
  mediaType   String? // "image" | "audio"

  status     String // "pending" | "sent" | "delivered" | "failed"
  externalId String?
  sentAt     DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String // "reminder" | "session" | "message" | "community" | "session_reminder"
  title     String
  body      String
  link      String?
  sessionId String? // voor session_reminder: welke sessie, om dubbele te voorkomen

  isRead Boolean   @default(false)
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([sessionId, type])
}

