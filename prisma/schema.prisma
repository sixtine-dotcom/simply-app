generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================
// PLATFORM (MULTI-TENANT CONTROL PLANE)
// ===========================================

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

enum PlanTier {
  STARTER
  PRO
  ENTERPRISE
}

// ===========================================
// USERS & AUTHENTICATION
// ===========================================

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
  COACH
  STUDENT
  CLIENT
  SUPPORT
}

enum HealthGoal {
  WEIGHT_LOSS
  WEIGHT_GAIN
  SYMPTOM_RELIEF
  MUSCLE_GAIN
}

enum BiologicalSex {
  FEMALE
  MALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  HIGH
  ATHLETE
}

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormQuestionType {
  SHORT_TEXT
  LONG_TEXT
  EMAIL
  PHONE
  NUMBER
  MULTIPLE_CHOICE
  CHECKBOXES
  DROPDOWN
  DATE
  YES_NO
  CONTACT_INFO
  FILE_UPLOAD
}

enum FormAssignmentAudienceType {
  ROLE
  COURSE
  SPACE
  USER
}

enum FormResponseStatus {
  IN_PROGRESS
  SUBMITTED
}

model Tenant {
  id              String       @id @default(cuid())
  name            String
  slug            String       @unique
  status          TenantStatus @default(TRIAL)
  plan            PlanTier     @default(STARTER)
  trialEndsAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?

  // Branding / white-label v1
  platformName String?
  logoUrl      String?
  primaryColor String?
  faviconUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  domains         TenantDomain[]
  settings        TenantSettings?
  subscriptions   TenantSubscription[]
  featureFlags    TenantFeatureFlag[]
  forms           Form[]
  formAssignments FormAssignment[]
  formResponses   FormResponse[]

  @@index([status])
  @@index([plan])
}

model TenantDomain {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  domain     String   @unique
  isPrimary  Boolean  @default(false)
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
}

model TenantSettings {
  id                      String    @id @default(cuid())
  tenantId                String    @unique
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platformName            String?
  logoUrl                 String?
  primaryColor            String?
  secondaryColor          String?
  faviconUrl              String?
  loginBackgroundUrl      String?
  loginVideoUrl           String?
  emailSenderName         String?
  emailReplyTo            String?
  footerText              String?
  billingCompanyName      String?
  billingContactName      String?
  billingEmail            String?
  billingVatNumber        String?
  billingStreet           String?
  billingPostalCode       String?
  billingCity             String?
  billingCountry          String?
  hidePoweredBy           Boolean   @default(false)
  customCss               String?   @db.Text
  communityIntroTitle     String?
  communityIntroBody      String?   @db.Text
  communityFlowTitle      String?
  communityFlowBody       String?   @db.Text
  communityFlowStep1Title String?
  communityFlowStep1Body  String?   @db.Text
  communityFlowStep2Title String?
  communityFlowStep2Body  String?   @db.Text
  communityFlowStep3Title String?
  communityFlowStep3Body  String?   @db.Text
  onboardingCompletedAt   DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model TenantSubscription {
  id                     String    @id @default(cuid())
  tenantId               String
  tenant                 Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                   PlanTier
  status                 String // "active" | "past_due" | "cancelled" | "trialing"
  billingInterval        String? // "monthly" | "yearly"
  currency               String?   @default("EUR")
  priceCents             Int?
  platformFeePercent     Int?
  stripeCustomerId       String?
  stripeSubscriptionId   String?
  cancelAtPeriodEnd      Boolean   @default(false)
  cancelledAt            DateTime?
  lastPaymentFailureAt   DateTime?
  pastDueStartedAt       DateTime?
  dunningReminder1SentAt DateTime?
  dunningReminder4SentAt DateTime?
  dunningReminder7SentAt DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([tenantId])
  @@index([status])
}

model TenantFeatureFlag {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  key         String
  isEnabled   Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}

model User {
  socialPublications SocialPublication[]
  id                 String              @id @default(cuid())
  tenantId           String?
  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  email              String              @unique
  emailVerified      DateTime?
  passwordHash       String?
  firstName          String
  lastName           String
  avatarUrl          String?
  bio                String?             @db.Text // korte beschrijving, niet verplicht
  role               Role                @default(CLIENT)
  preferredLanguage  String              @default("nl")
  phone              String?
  shopifyCustomerId  String?             @unique
  marketingConsent   Boolean             @default(false)
  marketingSource    String?
  marketingConsentAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?
  deletedAt   DateTime?

  // Relations
  sessions                 AuthSession[]
  enrollments              Enrollment[]
  progress                 Progress[]
  spaceMemberships         SpaceMember[]
  posts                    Post[]
  scheduledCommunityPosts  ScheduledCommunityPost[]
  postPollVotes            PostPollVote[]
  comments                 Comment[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  sessionsAsClient         CoachingSession[]         @relation("ClientSessions")
  sessionsAsCoach          CoachingSession[]         @relation("CoachSessions")
  coursesAsCoach           Course[]                  @relation("CourseCoach")
  calendarAccessAsCoach    CoachCalendarAccess[]     @relation("CoachCalendarAccessCoach")
  calendarAccessAsClient   CoachCalendarAccess[]     @relation("CoachCalendarAccessClient")
  checkIns                 CheckIn[]
  nutritionLogs            NutritionLog[]
  habitLogs                HabitLog[]
  cycleLogs                CycleLog[]
  symptomLogs              SymptomLog[]
  groceryLists             GroceryList[]
  mealPlans                MealPlan[]
  customRecipes            UserCustomRecipe[]
  favoriteRecipes          UserFavoriteRecipe[]
  aiConversations          AiConversation[]
  aiEscalations            AiEscalation[]
  whatsappMessages         WhatsappMessage[]
  notifications            Notification[]
  progressPhotos           ProgressPhoto[]
  fitnessConnections       FitnessConnection[]
  calendarConnections      CalendarConnection[]
  integrationConnections   IntegrationConnection[]
  externalCalendarEvents   ExternalCalendarEvent[]
  syncedCalendarEvents     SyncedCalendarEvent[]
  hostedRecordings         CoachingRecording[]       @relation("CoachRecordings")
  webinarRegistrations     WebinarRegistration[]
  webinarsHosted           Webinar[]                 @relation("WebinarHost")
  workouts                 Workout[]
  weeklySummaries          WeeklySummary[]
  offerAssignments         OfferAssignment[]
  assignedForms            FormAssignment[]          @relation("AssignedUserForms")
  formResponses            FormResponse[]
  healthProfile            UserHealthProfile?
  nutritionPlans           NutritionPlan[]
  emailCampaigns           EmailCampaign[]           @relation("EmailCampaignCreator")

  @@index([tenantId])
  @@index([email])
  @@index([shopifyCustomerId])
  @@index([tenantId, marketingConsent])
}

model UserHealthProfile {
  id                      String        @id @default(cuid())
  userId                  String        @unique
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal                    HealthGoal
  biologicalSex           BiologicalSex
  age                     Int
  heightCm                Int
  weightKg                Float
  targetWeightKg          Float?
  activityLevel           ActivityLevel
  trainingSessionsPerWeek Int
  averageDailySteps       Int
  primarySport            String?
  symptoms                String?       @db.Text
  calorieTarget           Int
  proteinTargetGrams      Int
  carbsTargetGrams        Int
  fatTargetGrams          Int
  completedAt             DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([goal])
  @@index([completedAt])
}

model VerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  type      String // "magic_link" | "registration" | "password_reset"
  metadata  Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([email])
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}

model Form {
  id                 String     @id @default(cuid())
  tenantId           String
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title              String
  slug               String     @unique
  description        String?    @db.Text
  status             FormStatus @default(DRAFT)
  introTitle         String?
  introDescription   String?    @db.Text
  submitButtonLabel  String?    @default("Versturen")
  successTitle       String?
  successDescription String?    @db.Text
  isOnboardingForm   Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  questions   FormQuestion[]
  assignments FormAssignment[]
  responses   FormResponse[]

  @@index([tenantId])
  @@index([status])
}

model FormQuestion {
  id          String           @id @default(cuid())
  formId      String
  form        Form             @relation(fields: [formId], references: [id], onDelete: Cascade)
  title       String
  description String?          @db.Text
  type        FormQuestionType
  position    Int              @default(0)
  isRequired  Boolean          @default(false)
  placeholder String?
  helperText  String?
  options     Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  answers FormAnswer[]

  @@index([formId])
  @@index([position])
}

model FormAssignment {
  id                 String                     @id @default(cuid())
  tenantId           String
  tenant             Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formId             String
  form               Form                       @relation(fields: [formId], references: [id], onDelete: Cascade)
  audienceType       FormAssignmentAudienceType
  audienceRole       Role?
  courseId           String?
  course             Course?                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  spaceId            String?
  space              Space?                     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId             String?
  user               User?                      @relation("AssignedUserForms", fields: [userId], references: [id], onDelete: Cascade)
  title              String?
  isRequired         Boolean                    @default(false)
  // Wanneer actief, blijft de gekoppelde cursus op slot tot dit formulier is ingediend.
  blocksCourseAccess Boolean                    @default(false)
  startsAt           DateTime?
  dueAt              DateTime?
  isActive           Boolean                    @default(true)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  responses FormResponse[]

  @@index([tenantId])
  @@index([formId])
  @@index([courseId])
  @@index([spaceId])
  @@index([userId])
}

model FormResponse {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  formId       String
  form         Form               @relation(fields: [formId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   FormAssignment?    @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       FormResponseStatus @default(IN_PROGRESS)
  startedAt    DateTime           @default(now())
  submittedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  answers FormAnswer[]

  @@unique([formId, assignmentId, userId])
  @@index([tenantId])
  @@index([formId])
  @@index([userId])
}

model FormAnswer {
  id         String       @id @default(cuid())
  responseId String
  response   FormResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId String
  question   FormQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value      Json
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([responseId, questionId])
  @@index([questionId])
}

// ===========================================
// COURSES & LEARNING
// ===========================================

model Course {
  id                  String  @id @default(cuid())
  title               String
  slug                String  @unique
  description         String? @db.Text
  thumbnailUrl        String?
  isPublished         Boolean @default(false)
  isPrivate           Boolean @default(false)
  hideForUnauthorized Boolean @default(true)
  communitySpaceId    String?
  communitySpace      Space?  @relation("CourseCommunitySpace", fields: [communitySpaceId], references: [id], onDelete: SetNull)

  // Minicursus zonder community: false; traject met groep: true
  hasCommunity Boolean @default(true)

  coachId String?
  coach   User?   @relation("CourseCoach", fields: [coachId], references: [id], onDelete: SetNull)

  drippingEnabled        Boolean @default(false)
  drippingUnit           String? // "days" | "weeks"
  drippingStartMode      String? // "enrollment" | "published"
  drippingReleaseWeekday Int? // 1 = Monday ... 7 = Sunday
  drippingReleaseTime    String? // "09:00"

  // Vaste looptijd van een traject/editie (bijv. Simply Challenge 15)
  trajectoryStartDate DateTime?
  trajectoryEndDate   DateTime?

  // Progressiefoto's: aantal momenten en interval (weken vanaf start inschrijving)
  photoMomentsCount         Int  @default(0)
  photoMomentsIntervalWeeks Int? // bijv. 4 = week 0, 4, 8, ...

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modules                 Module[]
  enrollments             Enrollment[]
  progressPhotos          ProgressPhoto[]
  coachingRecordings      CoachingRecording[]
  shopifyMappings         ShopifyProductMapping[]
  offerLinks              OfferCourse[]
  formAssignments         FormAssignment[]
  calendarAccessRules     CoachCalendarAccess[]
  scheduledCommunityPosts ScheduledCommunityPost[]
  nutritionPlanTemplates  NutritionPlanTemplate[]
  nutritionPlans          NutritionPlan[]

  @@index([slug])
  @@index([communitySpaceId])
  @@index([coachId])
}

model Offer {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  description        String?  @db.Text
  pricingType        String // "one_time" | "subscription" | "payment_plan"
  priceCents         Int
  currency           String   @default("EUR")
  billingInterval    String? // "monthly" | "yearly"
  trialDays          Int?
  installmentCount   Int?
  accessDurationDays Int?
  isPublished        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  courses     OfferCourse[]
  assignments OfferAssignment[]
  leads       OfferLead[]

  @@index([slug])
  @@index([pricingType])
}

model OfferCourse {
  id        String   @id @default(cuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([offerId, courseId])
  @@index([offerId])
  @@index([courseId])
}

model OfferAssignment {
  id        String    @id @default(cuid())
  offerId   String
  offer     Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate DateTime  @default(now())
  endDate   DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  enrollments Enrollment[]

  @@index([offerId])
  @@index([userId])
  @@index([revokedAt])
}

model OfferLead {
  id        String   @id @default(cuid())
  offerId   String
  offer     Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String?
  email     String
  note      String?  @db.Text
  status    String   @default("new") // "new" | "contacted" | "converted"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([offerId])
  @@index([email])
  @@index([status])
}

model CoachingRecording {
  id                      String           @id @default(cuid())
  courseId                String?
  course                  Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessionId               String?
  session                 CoachingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  coachId                 String?
  coach                   User?            @relation("CoachRecordings", fields: [coachId], references: [id], onDelete: SetNull)
  recurrenceOccurrenceKey String? // groepssessie: recur-{courseId}-{iso}
  dailyRecordingId        String           @unique // Daily.co recording ID
  title                   String?
  summary                 String?          @db.Text
  transcript              String?          @db.Text
  transcriptSourceUrl     String?
  googleDriveFileId       String?
  googleDriveWebViewLink  String?
  googleDriveFolderId     String?
  googleDriveUploadedAt   DateTime?
  scheduledAt             DateTime?
  durationSecs            Int?
  createdAt               DateTime         @default(now())

  @@index([courseId])
  @@index([sessionId])
  @@index([coachId])
  @@index([dailyRecordingId])
  @@index([googleDriveFileId])
}

model Webinar {
  id               String   @id @default(cuid())
  hostId           String
  host             User     @relation("WebinarHost", fields: [hostId], references: [id], onDelete: Cascade)
  title            String
  description      String?  @db.Text
  startsAt         DateTime
  duration         Int      @default(60)
  registrationSlug String   @unique
  autoRecord       Boolean  @default(true)
  status           String   @default("scheduled")
  roomId           String?
  roomUrl          String?
  eventType        String   @default("online") // "online" | "physical"
  location         String?
  onlineUrl        String?
  bannerUrl        String?
  capacity         Int?
  registrationOpen Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  registrations WebinarRegistration[]

  @@index([hostId])
  @@index([startsAt])
}

model WebinarRegistration {
  id         String    @id @default(cuid())
  webinarId  String
  webinar    Webinar   @relation(fields: [webinarId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName  String
  lastName   String?
  email      String
  phone      String?
  joinToken  String    @unique
  attendedAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([webinarId, email])
  @@index([webinarId])
  @@index([email])
}

model Module {
  id              String  @id @default(cuid())
  courseId        String
  course          Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String? @db.Text
  position        Int
  unlockAfterDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id             String  @id @default(cuid())
  moduleId       String
  module         Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title          String
  content        String? @db.Text
  extraContent   String? @db.Text
  checklistTitle String?
  checklistItems Json?
  position       Int

  videoUrl        String?
  videoProvider   String? // "loom" | "mux" | "upload"
  videoDuration   Int?
  videoEmbedCode  String? @db.Text
  unlockAfterDays Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress    Progress[]
  attachments LessonAttachment[]

  @@index([moduleId])
}

model LessonAttachment {
  id        String   @id @default(cuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      String // "pdf" | "image" | "file"
  size      Int?
  createdAt DateTime @default(now())

  @@index([lessonId])
}

model Enrollment {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId          String
  course            Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  offerAssignmentId String?
  offerAssignment   OfferAssignment? @relation(fields: [offerAssignmentId], references: [id], onDelete: SetNull)

  startDate DateTime  @default(now())
  endDate   DateTime?

  shopifyOrderId   String?
  shopifyOrderName String?
  shopifyProductId String?
  revenueCents     Int?
  revenueCurrency  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([offerAssignmentId])
}

model ProgressPhoto {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  periodIndex    Int // 0-based moment (week 0, 4, 8, ...)
  beforePhotoUrl String?
  afterPhotoUrl  String?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, courseId, periodIndex])
  @@index([userId])
  @@index([courseId])
}

model Progress {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  completedAt    DateTime?
  videoProgress  Int?
  checklistState Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// ===========================================
// COMMUNITY
// ===========================================

model Space {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  groupLabel  String?
  description String? @db.Text
  iconEmoji   String?

  isPublic   Boolean @default(false)
  isHostOnly Boolean @default(false)
  isActive   Boolean @default(true)
  position   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                 SpaceMember[]
  posts                   Post[]
  courses                 Course[]                 @relation("CourseCommunitySpace")
  formAssignments         FormAssignment[]
  scheduledCommunityPosts ScheduledCommunityPost[]

  @@index([slug])
  @@index([groupLabel])
}

model SpaceMember {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, spaceId])
  @@index([userId])
  @@index([spaceId])
}

model Post {
  id       String @id @default(cuid())
  spaceId  String
  space    Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  title        String?
  content      String   @db.Text
  pollQuestion String?
  pollOptions  Json?
  isPinned     Boolean  @default(false)
  workoutId    String?  @unique
  workout      Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments      Comment[]
  attachments   PostAttachment[]
  likes         PostLike[]
  pollVotes     PostPollVote[]
  scheduledFrom ScheduledCommunityPost?

  @@index([spaceId])
  @@index([authorId])
}

model ScheduledCommunityPost {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  spaceId  String
  space    Space  @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  title        String?
  content      String  @db.Text
  pollQuestion String?
  pollOptions  Json?
  attachments  Json?
  isPinned     Boolean @default(false)

  scheduledAt DateTime
  status      String    @default("scheduled") // "scheduled" | "published" | "cancelled" | "failed"
  publishedAt DateTime?
  cancelledAt DateTime?
  lastError   String?   @db.Text

  publishedPostId String? @unique
  publishedPost   Post?   @relation(fields: [publishedPostId], references: [id], onDelete: SetNull)

  duplicateSourceId String?
  duplicateSource   ScheduledCommunityPost?  @relation("ScheduledPostDuplicate", fields: [duplicateSourceId], references: [id], onDelete: SetNull)
  duplicates        ScheduledCommunityPost[] @relation("ScheduledPostDuplicate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([spaceId])
  @@index([authorId])
  @@index([scheduledAt])
  @@index([status])
  @@index([duplicateSourceId])
}

model PostAttachment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  url       String
  type      String // "image" | "video" | "voice_memo" | "file"
  duration  Int?
  createdAt DateTime @default(now())

  @@index([postId])
}

model PostPollVote {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  optionIndex Int
  createdAt   DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model Comment {
  id       String @id @default(cuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  content String @db.Text

  parentId    String?
  parent      Comment?            @relation("CommentReplies", fields: [parentId], references: [id])
  replies     Comment[]           @relation("CommentReplies")
  attachments CommentAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
}

model CommentAttachment {
  id        String   @id @default(cuid())
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  url       String
  type      String // "image" | "voice_memo" | "file"
  duration  Int?
  createdAt DateTime @default(now())

  @@index([commentId])
}

// ===========================================
// FITNESS / SPORTHORLOGES
// ===========================================

model FitnessConnection {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String // "strava" | "fitbit" | "garmin" | "polar" | "apple"
  providerUserId String?
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model CalendarConnection {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "microsoft"
  providerAccountId String?
  email             String?
  accessToken       String    @db.Text
  refreshToken      String?   @db.Text
  expiresAt         DateTime?
  scope             String?
  syncEnabled       Boolean   @default(true)
  lastSyncedAt      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  events       ExternalCalendarEvent[]
  syncedEvents SyncedCalendarEvent[]

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([syncEnabled])
}

model IntegrationConnection {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "canva" | "meta"
  providerAccountId String?
  accountName       String?
  accessToken       String    @db.Text
  refreshToken      String?   @db.Text
  expiresAt         DateTime?
  scope             String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
}

model ExternalCalendarEvent {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId    String
  connection      CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider        String // "google" | "microsoft"
  providerEventId String
  title           String
  description     String?            @db.Text
  location        String?
  startsAt        DateTime
  endsAt          DateTime
  isAllDay        Boolean            @default(false)
  externalUrl     String?
  updatedAt       DateTime           @updatedAt
  syncedAt        DateTime           @default(now())

  @@unique([connectionId, providerEventId])
  @@index([userId, startsAt])
  @@index([connectionId])
}

model SyncedCalendarEvent {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  connectionId    String
  connection      CalendarConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  provider        String // "google" | "microsoft"
  syncKey         String // CoachingSession.id or shared recurrenceOccurrenceKey
  providerEventId String
  externalUrl     String?
  lastSyncedAt    DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([connectionId, syncKey])
  @@index([userId])
  @@index([providerEventId])
}

model Workout {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "strava" | "fitbit" | ...
  providerWorkoutId String
  type              String? // "Run" | "Ride" | "Walk" | ...
  name              String?
  distance          Float? // meter
  durationSeconds   Int?
  elevationGain     Float?
  calories          Float?
  heartRateAvg      Int?
  heartRateMax      Int?
  startTime         DateTime
  endTime           DateTime?
  isPublic          Boolean   @default(false)
  syncedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  post Post?

  @@unique([userId, provider, providerWorkoutId])
  @@index([userId])
  @@index([provider])
  @@index([startTime])
  @@index([isPublic])
}

// ===========================================
// MESSAGING
// ===========================================

model Conversation {
  id            String    @id @default(cuid())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastMessageAt DateTime?

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastReadAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  content       String  @db.Text
  voiceUrl      String?
  voiceDuration Int?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
}

// ===========================================
// COACHING SESSIONS
// ===========================================

model CoachingSession {
  id       String @id @default(cuid())
  clientId String
  client   User   @relation("ClientSessions", fields: [clientId], references: [id], onDelete: Cascade)
  coachId  String
  coach    User   @relation("CoachSessions", fields: [coachId], references: [id], onDelete: Cascade)

  title       String?
  description String?  @db.Text
  scheduledAt DateTime
  duration    Int      @default(45)

  roomId                 String?
  roomUrl                String?
  autoRecord             Boolean  @default(true)
  isInstant              Boolean  @default(false)
  externalAttendeeEmails String[] @default([])

  // Groepssessie: meerdere sessies delen dezelfde room via deze key (bijv. recur-{courseId}-{isoDateTime})
  recurrenceOccurrenceKey String?

  status      String    @default("scheduled") // "scheduled" | "completed" | "cancelled"
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes      SessionNote[]
  recordings CoachingRecording[]

  @@index([clientId])
  @@index([coachId])
  @@index([scheduledAt])
  @@index([recurrenceOccurrenceKey])
}

model CoachCalendarAccess {
  id           String   @id @default(cuid())
  coachId      String
  coach        User     @relation("CoachCalendarAccessCoach", fields: [coachId], references: [id], onDelete: Cascade)
  audienceType String // "course" | "user"
  courseId     String?
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation("CoachCalendarAccessClient", fields: [userId], references: [id], onDelete: Cascade)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([coachId, audienceType, courseId, userId])
  @@index([coachId])
  @@index([courseId])
  @@index([userId])
}

model SessionNote {
  id                 String          @id @default(cuid())
  sessionId          String
  session            CoachingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  content            String          @db.Text
  isSharedWithClient Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([sessionId])
}

// ===========================================
// TRACKERS
