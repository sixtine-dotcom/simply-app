  year       Int
  date       DateTime

  weight Float?
  waist  Float?
  hip    Float?
  arm    Float?

  photoFront String?
  photoSide  String?
  photoBack  String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekNumber, year])
  @@index([userId])
}

model NutritionLog {
