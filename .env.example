# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/simply?schema=public"

# Auth
AUTH_SECRET="your-super-secret-key-min-32-chars"
APP_URL="http://localhost:3000"
# Alleen voor de lokale ontwikkel-login; wordt in productie nooit gebruikt.
DEV_ADMIN_EMAIL="sixtine@simplyinbalance.com"

# Email (Resend)
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="Simply <noreply@simplyinbalance.com>"

# Huddle (cursus-import) – token uit Instellingen → Integraties → Webhooks
# HUDDLE_API_TOKEN="eyJ0eXAi..."
# HUDDLE_API_BASE_URL="https://api.jouw-huddle-domein.nl"

# Shopify
SHOPIFY_SHOP_DOMAIN="your-shop.myshopify.com"
SHOPIFY_WEBHOOK_SECRET="your-webhook-secret"
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""

# Video hosting (Mux) - Add in Milestone 2
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# Live video (Daily.co) - Add in Milestone 4
DAILY_API_KEY=""
# In Daily dashboard: Webhooks → add endpoint POST {APP_URL}/api/webhooks/daily
# Event: recording.ready-to-download (zodat opnames onder cursus verschijnen)

# Google Calendar + Google Drive contentplanner
# Activeer in hetzelfde Google Cloud-project de Google Drive API en Google Calendar API.
# OAuth client type: Web application.
# Lokale redirect URI: http://localhost:3000/api/calendar/callback/google
# Productie redirect URI: https://simplyapp.be/api/calendar/callback/google
# Voeg sixtine@simplyinbalance.com als testgebruiker toe zolang de OAuth-app in Testing staat.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# Canva Connect API (OAuth + design picker/export)
# Redirect URI: {APP_URL}/api/integrations/canva/callback
CANVA_CLIENT_ID=""
CANVA_CLIENT_SECRET=""

# Meta / Instagram + Facebook publishing
# Redirect URI: {APP_URL}/api/integrations/meta/callback
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_VERSION="v23.0"
INSTAGRAM_APP_ID="1753986322424167"
INSTAGRAM_APP_SECRET=""
# Microsoft redirect URI: {APP_URL}/api/calendar/callback/microsoft
MICROSOFT_CALENDAR_CLIENT_ID=""
MICROSOFT_CALENDAR_CLIENT_SECRET=""
# Calendly redirect URI: {APP_URL}/api/calendar/callback/calendly
CALENDLY_CLIENT_ID=""
CALENDLY_CLIENT_SECRET=""

# Real-time (Pusher) - Add in Milestone 3
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_CLUSTER="eu"

# Storage (Cloudflare R2)
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
# Public URL can be an R2 public bucket URL or custom domain, without trailing slash.
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="simply-uploads"
R2_PUBLIC_URL=""

# AI (SIX via OpenAI / ChatGPT)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Nutrition database (Open Food Facts)
# Geen API key nodig voor basis product search en barcode lookup

# Recepten: auto-sync van website (nieuwe recepten direct in app)
# Volledige blog-URL, bijv. https://simplyinbalance.com/blogs/recepten
RECIPES_SOURCE_URL="https://simplyinbalance.com/blogs/recepten"

# Cron: Roep periodiek aan (zelfde CRON_SECRET)
# Sessie-herinneringen: GET /api/cron/session-reminders?secret=... (elke 10–15 min)
# Recepten sync: GET /api/cron/sync-recipes?secret=... (bijv. elk uur of dagelijks)
# Weekoverzichten: GET /api/cron/weekly-summaries?secret=... (zondagavond, stuurt notificatie + email)
CRON_SECRET=""

# WhatsApp (Twilio) - Add in Milestone 8
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""
GOOGLE_MAPS_API_KEY=""
