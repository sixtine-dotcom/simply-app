# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/simply?schema=public"

# Auth
AUTH_SECRET="your-super-secret-key-min-32-chars"
APP_URL="http://localhost:3000"

# Email (Resend)
RESEND_API_KEY="re_your_api_key"
EMAIL_FROM="Simply <noreply@simplyinbalance.com>"

# Huddle (cursus-import) – token uit Instellingen → Integraties → Webhooks
# HUDDLE_API_TOKEN="eyJ0eXAi..."
# HUDDLE_API_BASE_URL="https://api.jouw-huddle-domein.nl"

# Shopify
SHOPIFY_SHOP_DOMAIN="your-shop.myshopify.com"
SHOPIFY_WEBHOOK_SECRET="your-webhook-secret"
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""

# Video hosting (Mux) - Add in Milestone 2
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# Live video (Daily.co) - Add in Milestone 4
DAILY_API_KEY=""
# In Daily dashboard: Webhooks → add endpoint POST {APP_URL}/api/webhooks/daily
# Event: recording.ready-to-download (zodat opnames onder cursus verschijnen)

# Real-time (Pusher) - Add in Milestone 3
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
PUSHER_CLUSTER="eu"

# Storage (Cloudflare R2) - Add in Milestone 2
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="simply-uploads"
R2_PUBLIC_URL=""

# AI (OpenAI) - Add in Milestone 7
OPENAI_API_KEY=""

# Recepten: auto-sync van website (nieuwe recepten direct in app)
# Volledige blog-URL, bijv. https://simplyinbalance.com/blogs/recepten
RECIPES_SOURCE_URL="https://simplyinbalance.com/blogs/recepten"

# Cron: Roep periodiek aan (zelfde CRON_SECRET)
# Sessie-herinneringen: GET /api/cron/session-reminders?secret=... (elke 10–15 min)
# Recepten sync: GET /api/cron/sync-recipes?secret=... (bijv. elk uur of dagelijks)
# Weekoverzichten: GET /api/cron/weekly-summaries?secret=... (zondagavond, stuurt notificatie + email)
CRON_SECRET=""

# WhatsApp (Twilio) - Add in Milestone 8
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""
