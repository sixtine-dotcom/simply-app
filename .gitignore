# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# user uploads (progress photos, etc.)
/public/uploads

# misc
.DS_Store
*.pem
.clang-module-cache/
.wrangler/
.claude/
.vscode/
.tmp-*
bridge/trusted-read-shortening/
src/app/(dashboard)/admin/page 2.tsx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/prisma/migrations/**/migration_lock.toml

# iCloud: technische mappen niet synchroniseren
*.nosync

# Private configuration and credentials (including templates)
.env*
**/.env*
*.key
*.p12
*.pfx
credentials*.json
*service-account*.json

# Local tools, caches, generated output and backups
node_modules/
.next*
.tmp/
.codex/
.cursor/
.agents/
.impeccable/
build/
dist/
out/
coverage/
*.log
*.zip
*.tar
*.gz
*.sqlite*
*.db

# Media remain local or in object storage, never in Git
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.avif
*.heic
*.ico
*.svg
*.mp4
*.mov
*.m4v
*.webm
*.avi
*.mkv
*.mp3
*.wav
*.m4a
*.aac
*.ogg
*.pdf
*.woff
*.woff2
*.ttf
*.otf
*.eot

# Fonts the in-app carousel renderer needs (SIL OFL, see LICENSE files there)
!src/lib/carousel-render/fonts/*.woff

# Existing Canva examples supplied with the fixed Open Design brief.
!src/lib/carousel-render/briefing/referenties/*.jpg

# Native app icons and launch artwork must survive a fresh source checkout.
!android/app/src/main/res/**/*.png
!ios/App/App/Assets.xcassets/**/*.png

# Keep release signing material private.
*.jks
*.keystore
android/key.properties
android/keystore.properties
